# Sandbox reverse proxy (local demo only — port 81).
# Production uses the prod block below. The legacy XTransformPort open-proxy
# has been removed: it allowed arbitrary localhost port proxying (SSRF).
:81 {
	handle /api/health* {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote}
		}
	}
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote}
		}
	}
}

