# MORIVA — environment template (names only; never commit real values)
# Required
DATABASE_URL="file:./db/custom.db"

# Startup behaviour (AC-TE-10: demo mode refuses to start when NODE_ENV=production)
DEMO_MODE="true"                     # true in local/preview ONLY; production startup fails if true
SESSION_TTL_HOURS="8"                # 1–24
SMALL_CELL_THRESHOLD="5"             # privacy suppression threshold for dashboard cells

# Feature flags (ADR-0005: AI is hard-disabled in this prototype regardless of this value)
AI_REFLECTION_ENABLED="false"        # clamped off until clinical/privacy approvals exist
